# Rendered by the nginx image at start-up (envsubst on ${SERVER_NAME})
# TheHive on 443, Cortex on 9443. Certificate: nginx/certs/server.crt + server.key

server {
    listen 80;
    server_name ${SERVER_NAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    resolver 127.0.0.11 valid=10s ipv6=off;
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:1m;
    ssl_session_timeout 10m;

    client_max_body_size 2G;      # attachments
    proxy_buffering off;
    proxy_read_timeout 600;       # long polling (stream)
    proxy_send_timeout 600;

    location / {
        set $thehive_upstream http://thehive:9000;
        proxy_pass $thehive_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}

server {
    listen 9443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    resolver 127.0.0.11 valid=10s ipv6=off;
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 2G;
    proxy_buffering off;
    proxy_read_timeout 600;

    location / {
        set $cortex_upstream http://cortex:9001;
        proxy_pass $cortex_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
