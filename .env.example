# docker-compose.yml            -> copy to .env; THEHIVE_SECRET and SERVER_NAME are required
# docker-compose.standalone.yml -> .env is optional; every setting below has a default

# TheHive secret. Generate with: openssl rand -hex 32
# (standalone: if empty, a random one is created on first start and kept in a volume)
THEHIVE_SECRET=

# Hostname clients use for TheHive, must match the certificate
SERVER_NAME=thehive.example.com

# API key of TheHive's user in Cortex
# (standalone: when set, TheHive's Cortex connector is enabled)
CORTEX_API_KEY=

THEHIVE_VERSION=6.0.0-2
CASSANDRA_VERSION=4.1.12
ELASTICSEARCH_VERSION=8.19.25
CORTEX_VERSION=4.2.0
NGINX_VERSION=1.31.9
