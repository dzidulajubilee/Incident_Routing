# Everything here is optional - the compose file works without a .env.
# Copy to .env only to change something.

# Name put in the self-signed certificate (default: localhost)
#SERVER_NAME=thehive.example.com

# API key of TheHive's user in Cortex. When set, TheHive's Cortex connector is enabled.
#CORTEX_API_KEY=

# Fixed TheHive secret. Default: random, generated on first start and kept in the "secrets" volume.
#THEHIVE_SECRET=

#THEHIVE_VERSION=6.0.0-2
#CASSANDRA_VERSION=4.1.12
#ELASTICSEARCH_VERSION=8.19.25
#CORTEX_VERSION=4.2.0
#NGINX_VERSION=1.31.9
